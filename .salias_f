# universal-android-debloater-next-generation (fork) - aliases and functions
# Sourced by .salias when entering the project dir. Run 'help' to see commands.

# ── Help ──
function help
    clear
    cat ./.salias_help.txt
end

# ── Build / run ──
alias build='cargo build --release'
function run --description "Launch the deployed uad-ng GUI, detached from this terminal"
    setsid -f uad-ng >/dev/null 2>&1
end
alias deploy='cargo install --path crates/uad-gui'

# ── Fork sync ──
# gitupdate is the global fish function (~/.config/fish/functions/gitupdate.fish).
# This file used to carry a copy that ran `git rebase main` unchecked and then
# force-pushed and checked out regardless of the result — a conflict left the
# repo mid-rebase and pushed a half-synced branch. Do NOT redefine it here:
# a local definition is sourced on dir-entry and shadows the global one.
